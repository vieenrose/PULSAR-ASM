+      const float cb = (float)(int)(signed char)(wa[j >> 1] >> (16 * (j & 1) + 8));
+      const uint32_t u = xa[j];
+      da = __fmaf_rn(ca, __uint_as_float(u << 16), da);
+      da = __fmaf_rn(cb, __uint_as_float(u & 0xffff0000u), da);
+    }
+    acc = __fmaf_rn(sa, da, acc);
+  }
+  return make_float4(acc, 0.f, 0.f, 0.f);
+}
