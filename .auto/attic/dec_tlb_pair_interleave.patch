+    const int c = b + 32;
+    const int4 a0 = qt[b * 64], a1 = qt[b * 64 + 32], e0 = qt[c * 64], e1 = qt[c * 64 + 32];
+    const float sa = sts[b * 32], se = sts[c * 32];
+    const unsigned wa[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                             (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+    const unsigned we[8] = { (unsigned)e0.x, (unsigned)e0.y, (unsigned)e0.z, (unsigned)e0.w,
+                             (unsigned)e1.x, (unsigned)e1.y, (unsigned)e1.z, (unsigned)e1.w };
+    const uint32_t* xa = xw + b * 17; const uint32_t* xe = xw + c * 17;
+    float da = 0.f, de = 0.f;
+    #pragma unroll
+    for (int j = 0; j < 16; j++) {
+      const float ca = (float)(int)(signed char)(wa[j >> 1] >> (16 * (j & 1)));
+      const float cb = (float)(int)(signed char)(wa[j >> 1] >> (16 * (j & 1) + 8));
+      const float ga = (float)(int)(signed char)(we[j >> 1] >> (16 * (j & 1)));
+      const float gb = (float)(int)(signed char)(we[j >> 1] >> (16 * (j & 1) + 8));
+      const uint32_t u = xa[j], v = xe[j];
+      da = __fmaf_rn(ca, __uint_as_float(u << 16), da); de = __fmaf_rn(ga, __uint_as_float(v << 16), de);
+      da = __fmaf_rn(cb, __uint_as_float(u & 0xffff0000u), da); de = __fmaf_rn(gb, __uint_as_float(v & 0xffff0000u), de);
+    }
+    acc = __fmaf_rn(se, de, __fmaf_rn(sa, da, acc));
+  }
+  if (b < nb) {
+    const int4 a0 = qt[b * 64], a1 = qt[b * 64 + 32];
+    const float sa = sts[b * 32];
+    const unsigned wa[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                             (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+    const uint32_t* xa = xw + b * 17;
