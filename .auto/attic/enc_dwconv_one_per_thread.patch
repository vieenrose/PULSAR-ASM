                     int C, int nH, int nW, int nHo, int nWo, int silu, int in1) {
   const int items = C * nHo * ((nWo + 3) / 4);
@@ -224,6 +256,11 @@ static void conv3x3(const float* in, const float* w, const float* b, float* out,
   } else if (in1) {                                   // flat work-item grid (A/B arm)
     k_conv3x3<1><<<(C * nHo * ((nWo + 3) / 4) + 255) / 256, 256>>>(in, w, b, out, C, nH, nW, nHo, nWo, silu);
   } else {
+    static const int dw1 = getenv("LFM_ENC_DW1") ? atoi(getenv("LFM_ENC_DW1")) : 1;
+    if (dw1) {
+      const size_t n = (size_t)C * nHo * nWo;
