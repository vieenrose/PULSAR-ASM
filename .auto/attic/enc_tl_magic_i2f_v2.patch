+// tl_leaf4m: tl_leaf4v with the odd codes (bytes 1 and 3) converted without I2F: the
+// biased byte (c ^ 0x80) is placed by PRMT under 0x4B000000 (= 2^23 + that byte) and 2^23 +
+// 128 is subtracted -- exact for every int8 (integers < 2^24). Same values, same FMAs.
+__device__ __forceinline__ float tl_mag(unsigned wx, unsigned sel) {
+  return __fsub_rn(__int_as_float((int)__byte_perm(wx, 0x4B000000u, sel)), 8388736.f);
+}
+__device__ __noinline__ float4 tl_leaf4m(const int4* __restrict__ qt, const float* __restrict__ st_s,
+                                         const float* xs, int b) {
+  const int4 a0 = qt[b * 64], a1 = qt[b * 64 + 32];
+  const unsigned w[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                          (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+  const float sb = st_s[b * 32];
+  const float4* xb = reinterpret_cast<const float4*>(xs + b * 32);
+  float dot[4] = { 0.f, 0.f, 0.f, 0.f };
+  #pragma unroll
+  for (int q = 0; q < 8; q++) {
+    const unsigned wx = w[q] ^ 0x80808080u;
+    const float c0 = (float)(int)(signed char)(w[q]);
+    const float c1 = tl_mag(wx, 0x7441u);
+    const float c2 = (float)(int)(signed char)(w[q] >> 16);
+    const float c3 = tl_mag(wx, 0x7443u);
+    #pragma unroll
+    for (int p = 0; p < 4; p++) {
+      const float4 u = xb[p * (24 * 8) + q];
+      dot[p] = __fmaf_rn(c0, u.x, dot[p]);
+      dot[p] = __fmaf_rn(c1, u.y, dot[p]);
+      dot[p] = __fmaf_rn(c2, u.z, dot[p]);
+      dot[p] = __fmaf_rn(c3, u.w, dot[p]);
+    }
+  }
+  return make_float4(__fmaf_rn(sb, dot[0], 0.f), __fmaf_rn(sb, dot[1], 0.f),
+                     __fmaf_rn(sb, dot[2], 0.f), __fmaf_rn(sb, dot[3], 0.f));
+}
