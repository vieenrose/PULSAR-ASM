+// tlf_leaf4b: leaves i and i + 16 (nb == 64: blocks i, i + 32 and i + 16, i + 48) with all
+// four dot chains interleaved; each leaf's value is tlf_leaf2b's (same chains, same fold).
+struct f8 { float4 a, b; };
+template <int CT>
+__device__ __noinline__ f8 tlf_leaf4b(const int4* __restrict__ qt, const float* __restrict__ sts,
+                                      const float* xf, int i, int K) {
+  const int bk[4] = { i, i + 32, i + 16, i + 48 };
+  unsigned w[4][8]; float sc[4];
+  #pragma unroll
+  for (int r = 0; r < 4; r++) {
+    const int4 u0 = qt[bk[r] * 64], u1 = qt[bk[r] * 64 + 32];
+    w[r][0] = u0.x; w[r][1] = u0.y; w[r][2] = u0.z; w[r][3] = u0.w;
+    w[r][4] = u1.x; w[r][5] = u1.y; w[r][6] = u1.z; w[r][7] = u1.w;
+    sc[r] = sts[bk[r] * 32];
+  }
+  float d[4][4];
+  #pragma unroll
+  for (int r = 0; r < 4; r++)
+    #pragma unroll
+    for (int p = 0; p < 4; p++) d[r][p] = 0.f;
+  #pragma unroll
+  for (int j = 0; j < 16; j++) {
+    #pragma unroll
+    for (int r = 0; r < 4; r++) {
+      const float ca = (float)(int)(signed char)(w[r][j >> 1] >> (16 * (j & 1)));
+      const float cb = (float)(int)(signed char)(w[r][j >> 1] >> (16 * (j & 1) + 8));
+      const float2* xr = reinterpret_cast<const float2*>(xf + bk[r] * 32);
+      #pragma unroll
+      for (int p = 0; p < CT; p++) {
+        const float2 u = xr[p * (K / 2) + j];
+        d[r][p] = __fmaf_rn(ca, u.x, d[r][p]);
+        d[r][p] = __fmaf_rn(cb, u.y, d[r][p]);
+      }
+    }
+  }
+  f8 o; float A[4], B[4];
+  #pragma unroll
+  for (int p = 0; p < 4; p++) {
+    A[p] = __fmaf_rn(sc[1], d[1][p], __fmaf_rn(sc[0], d[0][p], 0.f));
+    B[p] = __fmaf_rn(sc[3], d[3][p], __fmaf_rn(sc[2], d[2][p], 0.f));
+  }
+  o.a = make_float4(A[0], A[1], A[2], A[3]); o.b = make_float4(B[0], B[1], B[2], B[3]);
+  return o;
+}
