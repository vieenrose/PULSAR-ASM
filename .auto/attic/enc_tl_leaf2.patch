+// tl_leaf4v2 (XV = 5): blocks b and b + 16 in one call, both blocks' weights loaded before
+// block b's FMAs, so block b + 16's load is hidden (a single-block leaf exposes every
+// load). Each block keeps its own chain and v = fmaf(sb, dot, 0.f); the caller adds lo + hi
+// exactly as before: bit-identical.
+struct tl_f8 { float4 a, b; };
+__device__ __forceinline__ void tl_blk4v(const unsigned (&w)[8], float sb, const float4* xb, float (&v)[4]) {
+  float dot[4] = { 0.f, 0.f, 0.f, 0.f };
+  #pragma unroll
+  for (int q = 0; q < 8; q++) {
+    const float c0 = (float)(int)(signed char)(w[q]);
+    const float c1 = (float)(int)(signed char)(w[q] >> 8);
+    const float c2 = (float)(int)(signed char)(w[q] >> 16);
+    const float c3 = (float)(int)(signed char)(w[q] >> 24);
+    #pragma unroll
+    for (int p = 0; p < 4; p++) {
+      const float4 u = xb[p * (24 * 8) + q];
+      dot[p] = __fmaf_rn(c0, u.x, dot[p]);
+      dot[p] = __fmaf_rn(c1, u.y, dot[p]);
+      dot[p] = __fmaf_rn(c2, u.z, dot[p]);
+      dot[p] = __fmaf_rn(c3, u.w, dot[p]);
+    }
+  }
+  #pragma unroll
+  for (int p = 0; p < 4; p++) v[p] = __fmaf_rn(sb, dot[p], 0.f);
+}
+__device__ __noinline__ tl_f8 tl_leaf4v2(const int4* __restrict__ qt, const float* __restrict__ st_s,
+                                         const float* xs, int b) {
+  const int4 a0 = qt[b * 64], a1 = qt[b * 64 + 32];
+  const int4 c0 = qt[(b + 16) * 64], c1 = qt[(b + 16) * 64 + 32];
+  const float sb = st_s[b * 32], sc = st_s[(b + 16) * 32];
+  const unsigned w[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                          (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+  float v[4], u[4];
+  tl_blk4v(w, sb, reinterpret_cast<const float4*>(xs + b * 32), v);
+  const unsigned z[8] = { (unsigned)c0.x, (unsigned)c0.y, (unsigned)c0.z, (unsigned)c0.w,
+                          (unsigned)c1.x, (unsigned)c1.y, (unsigned)c1.z, (unsigned)c1.w };
+  tl_blk4v(z, sc, reinterpret_cast<const float4*>(xs + (b + 16) * 32), u);
+  tl_f8 r; r.a = make_float4(v[0], v[1], v[2], v[3]); r.b = make_float4(u[0], u[1], u[2], u[3]);
+  return r;
+}
