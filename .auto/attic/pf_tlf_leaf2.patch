+// tlf_leaf2 (PF = 9): leaves i0 and i1 in one call, the 1-deep weight prefetch running
+// across all 2 * nb / 32 blocks, so only the first block's load of the pair is exposed
+// (at K = 2048 a single leaf has 2 blocks, so PF = 1 exposed every other load). Each leaf
+// keeps its own acc chain; needs nb % 32 == 0. Same operands, same order: bit-identical.
+struct tlf_f8 { float4 a, b; };
+template <int CT>
+__device__ __noinline__ tlf_f8 tlf_leaf2(const int4* __restrict__ qt, const float* __restrict__ sts,
+                                         const float* xf, int i0, int i1, int nb, int K) {
+  const int mm = nb >> 5, nt = 2 * mm;
+  float acc[4] = { 0.f, 0.f, 0.f, 0.f }, o0[4] = { 0.f, 0.f, 0.f, 0.f };
+  int4 n0 = qt[i0 * 64], n1 = qt[i0 * 64 + 32]; float nsb = sts[i0 * 32];
+  for (int n = 0; n < nt; n++) {
+    const int b = n < mm ? i0 + 32 * n : i1 + 32 * (n - mm);
+    const int4 a0 = n0, a1 = n1; const float sb = nsb;
+    if (n + 1 < nt) {
+      const int b2 = n + 1 < mm ? i0 + 32 * (n + 1) : i1 + 32 * (n + 1 - mm);
+      n0 = qt[b2 * 64]; n1 = qt[b2 * 64 + 32]; nsb = sts[b2 * 32];
+    }
+    const unsigned w[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                            (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+    float dot[4] = { 0.f, 0.f, 0.f, 0.f };
+    const float2* xb = reinterpret_cast<const float2*>(xf + b * 32);
+    #pragma unroll
+    for (int j = 0; j < 16; j++) {
+      const float ca = (float)(int)(signed char)(w[j >> 1] >> (16 * (j & 1)));
+      const float cb = (float)(int)(signed char)(w[j >> 1] >> (16 * (j & 1) + 8));
+      #pragma unroll
+      for (int p = 0; p < CT; p++) {
+        const float2 u = xb[p * (K / 2) + j];
+        dot[p] = __fmaf_rn(ca, u.x, dot[p]);
+        dot[p] = __fmaf_rn(cb, u.y, dot[p]);
+      }
+    }
+    #pragma unroll
+    for (int p = 0; p < CT; p++) acc[p] = __fmaf_rn(sb, dot[p], acc[p]);
+    if (n == mm - 1) {
+      #pragma unroll
+      for (int p = 0; p < 4; p++) { o0[p] = acc[p]; acc[p] = 0.f; }
+    }
+  }
+  tlf_f8 r; r.a = make_float4(o0[0], o0[1], o0[2], o0[3]); r.b = make_float4(acc[0], acc[1], acc[2], acc[3]);
+  return r;
+}
