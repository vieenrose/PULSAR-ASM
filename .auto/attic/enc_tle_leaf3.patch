+// tle_leaf3 (LFM_ENC_XE=6): leaf A = blocks i, i + 32 (stage offset oa) and leaf B = block
+// i + 16 alone (offset ob), all three dot chains interleaved; A folds as
+// fma(s1, d1, fma(s0, d0, 0)) and B as fma(s2, d2, 0): tle_leaf<4>'s values.
+struct tle8 { float4 a, b; };
+__device__ __noinline__ tle8 tle_leaf3(const int4* __restrict__ qt, const float* __restrict__ sts,
+                                       int oa, int ob, int i) {
+  extern __shared__ float xe_dyn[];
+  const int bk[3] = { i, i + 32, i + 16 };
+  const int xo[3] = { oa, oa + 128, ob };
+  unsigned w[3][8]; float sc[3];
+  #pragma unroll
+  for (int r = 0; r < 3; r++) {
+    const int4 u0 = qt[bk[r] * 64], u1 = qt[bk[r] * 64 + 32];
+    w[r][0] = u0.x; w[r][1] = u0.y; w[r][2] = u0.z; w[r][3] = u0.w;
+    w[r][4] = u1.x; w[r][5] = u1.y; w[r][6] = u1.z; w[r][7] = u1.w;
+    sc[r] = sts[bk[r] * 32];
+  }
+  float d[3][4];
+  #pragma unroll
+  for (int r = 0; r < 3; r++)
+    #pragma unroll
+    for (int p = 0; p < 4; p++) d[r][p] = 0.f;
+  #pragma unroll
+  for (int q = 0; q < 8; q++) {
+    #pragma unroll
+    for (int r = 0; r < 3; r++) {
+      const float c0 = (float)(int)(signed char)(w[r][q]), c1 = (float)(int)(signed char)(w[r][q] >> 8);
+      const float c2 = (float)(int)(signed char)(w[r][q] >> 16), c3 = (float)(int)(signed char)(w[r][q] >> 24);
+      const float4* xv = reinterpret_cast<const float4*>(xe_dyn + xo[r]);
+      #pragma unroll
+      for (int p = 0; p < 4; p++) {
+        const float4 u = xv[p * 8 + q];
+        d[r][p] = __fmaf_rn(c0, u.x, d[r][p]); d[r][p] = __fmaf_rn(c1, u.y, d[r][p]);
+        d[r][p] = __fmaf_rn(c2, u.z, d[r][p]); d[r][p] = __fmaf_rn(c3, u.w, d[r][p]);
+      }
+    }
+  }
+  tle8 o; float A[4], B[4];
+  #pragma unroll
+  for (int p = 0; p < 4; p++) {
+    A[p] = __fmaf_rn(sc[1], d[1][p], __fmaf_rn(sc[0], d[0][p], 0.f));
+    B[p] = __fmaf_rn(sc[2], d[2][p], 0.f);
+  }
+  o.a = make_float4(A[0], A[1], A[2], A[3]); o.b = make_float4(B[0], B[1], B[2], B[3]);
+  return o;
+}
