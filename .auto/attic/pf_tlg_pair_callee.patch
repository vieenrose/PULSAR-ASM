 __shared__ float g_tlg_xf8[8 * 8 * 64 * 2];
+// tlg_pair (XG 13): leaf blocks b, b + 32 (stage slots m, m + 1) with interleaved dot
+// chains, folded into acc in block order. Its own call frame, so the 8-chain body does not
+// share registers with the kernel's tree state (#163's 248 B spill).
+__device__ __noinline__ float4 tlg_pair(const int4* __restrict__ qt, const float* __restrict__ sts,
+                                        const float* xfb, int b, int m, float4 acc4) {
+  const int c = b + 32;
+  const int4 a0 = qt[b * 64], a1 = qt[b * 64 + 32], e0 = qt[c * 64], e1 = qt[c * 64 + 32];
+  const float sa = sts[b * 32], se = sts[c * 32];
+  const unsigned wa[8] = { (unsigned)a0.x, (unsigned)a0.y, (unsigned)a0.z, (unsigned)a0.w,
+                           (unsigned)a1.x, (unsigned)a1.y, (unsigned)a1.z, (unsigned)a1.w };
+  const unsigned we[8] = { (unsigned)e0.x, (unsigned)e0.y, (unsigned)e0.z, (unsigned)e0.w,
+                           (unsigned)e1.x, (unsigned)e1.y, (unsigned)e1.z, (unsigned)e1.w };
+  const float4* fa = reinterpret_cast<const float4*>(xfb + 2 * (m * 64));
+  const float4* fe = reinterpret_cast<const float4*>(xfb + 2 * ((m + 1) * 64));
+  float da[4] = { 0.f, 0.f, 0.f, 0.f }, de[4] = { 0.f, 0.f, 0.f, 0.f };
+  #pragma unroll
+  for (int q = 0; q < 8; q++) {
+    const float c0 = (float)(int)(signed char)(wa[q]), c1 = (float)(int)(signed char)(wa[q] >> 8);
+    const float c2 = (float)(int)(signed char)(wa[q] >> 16), c3 = (float)(int)(signed char)(wa[q] >> 24);
+    const float g0 = (float)(int)(signed char)(we[q]), g1 = (float)(int)(signed char)(we[q] >> 8);
+    const float g2 = (float)(int)(signed char)(we[q] >> 16), g3 = (float)(int)(signed char)(we[q] >> 24);
+    #pragma unroll
+    for (int p = 0; p < 4; p++) {
+      const float4 u = fa[p * 8 + q], v = fe[p * 8 + q];
+      da[p] = __fmaf_rn(c0, u.x, da[p]); de[p] = __fmaf_rn(g0, v.x, de[p]);
+      da[p] = __fmaf_rn(c1, u.y, da[p]); de[p] = __fmaf_rn(g1, v.y, de[p]);
+      da[p] = __fmaf_rn(c2, u.z, da[p]); de[p] = __fmaf_rn(g2, v.z, de[p]);
+      da[p] = __fmaf_rn(c3, u.w, da[p]); de[p] = __fmaf_rn(g3, v.w, de[p]);
+    }
+  }
+  float acc[4] = { acc4.x, acc4.y, acc4.z, acc4.w };
+  #pragma unroll
+  for (int p = 0; p < 4; p++) acc[p] = __fmaf_rn(se, de[p], __fmaf_rn(sa, da[p], acc[p]));
+  return make_float4(acc[0], acc[1], acc[2], acc[3]);
+}
