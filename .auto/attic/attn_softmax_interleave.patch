+      }
+    }
+    #pragma unroll
+    for (int g = 0; g < G; g++) {
+      #pragma unroll
+      for (int o = 16; o > 0; o >>= 1) sum[g] = __fadd_rn(sum[g], __shfl_down_sync(~0u, sum[g], o));
+      if (lane == 0) redG[g][wid] = sum[g];
+    }
+    __syncthreads();
