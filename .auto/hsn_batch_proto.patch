+/* Multi-token hs (prototype for N > 1 sequences): NB activation plane sets
+ * (stride pls words) share every loaded weight word. Per set the integer
+ * group sums, the fl(fl(ws db) isum) products and the ascending-group row
+ * chain are those of pq1_gemv_hs (SM form), so each set's y is bit-identical
+ * to its own single-token call. WR warps per row team, warp 0 sums the rows
+ * (the non-SEG chain: same order as SEG). */
+template <int NB, int WR, int TPB, int MINB, int RB, int PD>
+__global__ __launch_bounds__(32 * WR * TPB, MINB)
+void pq1_gemv_hsn(const uint8_t* __restrict__ w_codes, const __half* __restrict__ w_scales,
+                  const uint32_t* __restrict__ xpl, int pls, float* __restrict__ y, int ys, int N) {
+  static_assert(RB % PD == 0 && NB * RB <= 32, "ring / reduction lanes");
+  constexpr int G = 32 * WR, PS = G + 4;
+  __shared__ __align__(16) float sh_p[TPB][2][NB * RB * PS];
+  const int warp = (int)threadIdx.x >> 5, lane = (int)threadIdx.x & 31;
+  const int team = warp / WR, wt = warp - team * WR;
+  const int g = wt * 32 + lane;
+  uint32_t p[NB][8][4], n[NB][4];
+  int cg[NB];
+  float db[NB];
+#pragma unroll
+  for (int b = 0; b < NB; b++) {
+    const uint32_t* pb = xpl + (size_t)b * pls + (g >> 1) * 73 + 1 + (g & 1) * 32;
+#pragma unroll
+    for (int j = 0; j < 4; j++)
+#pragma unroll
+      for (int q = 0; q < 8; q++) p[b][q][j] = __ldg(pb + j * 8 + q);
+    db[b] = __int_as_float((int)__ldg(xpl + (size_t)b * pls + (g >> 1) * 73));
+    int asum = 0;
+#pragma unroll
+    for (int j = 0; j < 4; j++) {
+      n[b][j] = ~p[b][7][j];
+      uint32_t c = n[b][j];
+#pragma unroll
+      for (int q = 0; q < 7; q++) {
+        const uint32_t t = p[b][q][j] ^ n[b][j];
+        p[b][q][j] = t ^ c;
+        c &= t;
+        asum += __popc(p[b][q][j]) << q;
+      }
+    }
+    cg[b] = -asum;
+  }
+  const int nbatch = (N + RB - 1) / RB;
+  const int stride = (int)gridDim.x * TPB;
+  int bi = (int)blockIdx.x * TPB + team;
+  if (bi >= nbatch) return;
+  const uint4* wq = reinterpret_cast<const uint4*>(w_codes) + g;
+  const __half* sq = w_scales + g;
+  int r0 = min(bi * RB, N - RB);
+  const uint4* wb = wq + (size_t)r0 * G;
+  const __half* sb = sq + (size_t)r0 * G;
+  uint4 cwr[PD];
+  __half wsr[PD];
+#pragma unroll
+  for (int i = 0; i < PD; i++) { cwr[i] = __ldg(wb + i * G); wsr[i] = __ldg(sb + i * G); }
+  int buf = 0;
+  for (;;) {
+    const int bnext = bi + stride;
+    const int rn0 = bnext < nbatch ? min(bnext * RB, N - RB) : r0;
+    const uint4* wn = wq + (size_t)rn0 * G;
+    const __half* sn = sq + (size_t)rn0 * G;
+    float* P = sh_p[team][buf];
+#pragma unroll
+    for (int rr = 0; rr < RB; rr++) {
+      const uint4 cw = cwr[rr % PD];
+      const float ws = __half2float(wsr[rr % PD]);
+      if (rr + PD < RB) {
+        cwr[rr % PD] = __ldg(wb + (rr + PD) * G);
+        wsr[rr % PD] = __ldg(sb + (rr + PD) * G);
+      } else {
+        cwr[rr % PD] = __ldg(wn + (rr + PD - RB) * G);
+        wsr[rr % PD] = __ldg(sn + (rr + PD - RB) * G);
+      }
+#pragma unroll
+      for (int b = 0; b < NB; b++) {
+        const int isum = 2 * hs_group_s(p[b], n[b], cw) + cg[b];
+        P[(b * RB + rr) * PS + g] = __fmul_rn(__fmul_rn(ws, db[b]), (float)isum);
+      }
+    }
+    if (WR == 1) __syncwarp();
+    else asm volatile("bar.sync %0, %1;" ::"r"(team + 1), "r"(WR * 32));
+    if (wt == 0 && lane < NB * RB) {
+      const float4* src = reinterpret_cast<const float4*>(P + lane * PS);
+      float acc = 0.0f;
+#pragma unroll
+      for (int k = 0; k < G / 4; k++) {
+        const float4 v = src[k];
+        acc = __fadd_rn(acc, v.x);
+        acc = __fadd_rn(acc, v.y);
+        acc = __fadd_rn(acc, v.z);
+        acc = __fadd_rn(acc, v.w);
+      }
+      y[(size_t)(lane / RB) * ys + r0 + lane % RB] = acc;
+    }
+    if (bnext >= nbatch) break;
+    if (WR == 1) __syncwarp();
+    else buf ^= 1;
+    bi = bnext; r0 = rn0; wb = wn; sb = sn;
+  }
+}
+template <int NB, int WR, int TPB, int MINB, int RB, int PD>
+static int hsn_go(const uint8_t* w, const __half* ws, const uint32_t* xpl, int pls, float* y, int ys,
+                  int N, cudaStream_t s) {
+  static int nres = 0;
+  if (!nres) {
+    int per = 0;
+    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per, pq1_gemv_hsn<NB, WR, TPB, MINB, RB, PD>, 32 * WR * TPB, 0);
+    nres = per > 0 ? per : 1;
+  }
+  int nblk = ((N + RB - 1) / RB + TPB - 1) / TPB;
+  if (nblk > nres) nblk = nres;
+  pq1_gemv_hsn<NB, WR, TPB, MINB, RB, PD><<<nblk, 32 * WR * TPB, 0, s>>>(w, ws, xpl, pls, y, ys, N);
+  return cudaGetLastError() == cudaSuccess ? 0 : -1;
+}
+/* nb plane sets at xpl + b * pls words, outputs at y + b * ys floats; K 4096 or 12288 */
+extern "C" int pq1_gemv_hsn_launch(const uint8_t* w_codes, const unsigned short* w_scales_h, const uint32_t* xpl,
+                                   int pls, float* y, int ys, int K, int N, int nb, int cfg, void* stream) {
+  const __half* ws = reinterpret_cast<const __half*>(w_scales_h);
+  cudaStream_t s = (cudaStream_t)stream;
+  if (N < 16) return -2;
+  if (K == 4096) {
+    if (nb == 1) return hsn_go<1, 1, 4, 6, 6, 6>(w_codes, ws, xpl, pls, y, ys, N, s);
+    if (nb == 2) {
+      if (cfg == 1) return hsn_go<2, 1, 4, 2, 4, 4>(w_codes, ws, xpl, pls, y, ys, N, s);
+      if (cfg == 2) return hsn_go<2, 1, 4, 3, 2, 2>(w_codes, ws, xpl, pls, y, ys, N, s);
+      return hsn_go<2, 1, 4, 2, 6, 3>(w_codes, ws, xpl, pls, y, ys, N, s);
+    }
+    if (nb == 3) return hsn_go<3, 1, 4, 2, 4, 2>(w_codes, ws, xpl, pls, y, ys, N, s);
+    if (nb == 4) return hsn_go<4, 1, 4, 1, 4, 2>(w_codes, ws, xpl, pls, y, ys, N, s);
+  } else if (K == 12288) {
+    if (nb == 1) return hsn_go<1, 3, 2, 4, 4, 4>(w_codes, ws, xpl, pls, y, ys, N, s);
+    if (nb == 2) return hsn_go<2, 3, 2, 2, 4, 2>(w_codes, ws, xpl, pls, y, ys, N, s);
+  }
+  return -2;
+}
