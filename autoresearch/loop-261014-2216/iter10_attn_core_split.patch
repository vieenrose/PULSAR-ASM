                                float* qo_d, float* kc_d, float* vc_d, float* atto_d, int nh,
                                int nkv, int ctx, void* stream) {
@@ -1349,6 +1424,18 @@ extern "C" int pq1_attn_launch(const float* qkv_d, const float* nw_d, const uint
   else
     pq1_attn_pre<<<(nh + 2 * nkv) / 4, 128, 0, s>>>(qkv_d, nw_d, par_d, qo_d, kc_d, vc_d, nh, nkv, ctx);
   if (cudaGetLastError() != cudaSuccess) return -1;
+  static int acore = -1;
+  if (acore < 0) { const char* e = getenv("PQ1_ACORE"); acore = e ? atoi(e) : 1; }
+  if (acore && nh <= 64) {
+    float* eb = atto_d + (size_t)nh * 128;          /* scratch after atto */
+    float* esf = eb + (size_t)nh * PQ1_ACTX;
+    pq1_attn_qk<<<nh, 128, 0, s>>>(qo_d, kc_d, par_d, eb, nh, nkv, ctx);
+    if (cudaGetLastError() != cudaSuccess) return -1;
+    pq1_attn_es<<<1, 64, 0, s>>>(eb, par_d, esf, nh);
+    if (cudaGetLastError() != cudaSuccess) return -1;
+    pq1_attn_pv<<<nh, 128, 0, s>>>(vc_d, par_d, eb, esf, atto_d, nh, nkv, ctx);
+    return (cudaGetLastError() == cudaSuccess) ? 0 : -1;
+  }
   pq1_attn_core<<<nh, 128, 0, s>>>(qo_d, kc_d, vc_d, par_d, atto_d, nh, nkv, ctx);
   return (cudaGetLastError() == cudaSuccess) ? 0 : -1;
 }
